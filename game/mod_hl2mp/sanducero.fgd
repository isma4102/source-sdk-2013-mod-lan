// Sanducero / Supervivencia Paysandu
// Hammer: include this FGD on top of the HL2MP FGD.
// These are point and brush classes. This file does not ship a map.

@PointClass base(Targetname) iconsprite("editor/info_target.vmt") = info_survival_safehouse : "Refugio reclamable. El jugador dentro del radio ejecuta survival_claim_safehouse."
[
	radius(float) : "Radio" : 384 : "Unidades. El jugador tiene que estar dentro."
	require_clear(choices) : "Exigir zona limpia" : 1 =
	[
		0 : "No"
		1 : "Si"
	]
	door(target_destination) : "Puerta 1" : : "Nombre de un func_door o func_door_rotating. Recibe Lock."
	door2(target_destination) : "Puerta 2" : ""
	close_doors(choices) : "Cerrar al reclamar" : 0 =
	[
		0 : "No"
		1 : "Si"
	]
	input Claim(void) : "Reclamar. El activador, si es jugador, recibe el mensaje."
	output OnClaimed(void) : "Se reclamo. Conectar a un logic_relay para cerrar brush que este codigo no puede crear."
	output OnClaimFailed(void) : "Habia infectados dentro, o el reclamo no se completo."
]

@SolidClass base(Targetname) = trigger_survival_safehouse : "Volumen de refugio. El jugador dentro ejecuta survival_claim_safehouse. El brush lo pone el mapa."
[
	require_clear(choices) : "Exigir zona limpia" : 1 =
	[
		0 : "No"
		1 : "Si"
	]
	door(target_destination) : "Puerta 1" : ""
	door2(target_destination) : "Puerta 2" : ""
	close_doors(choices) : "Cerrar al reclamar" : 0 =
	[
		0 : "No"
		1 : "Si"
	]
	input Claim(void) : "Reclamar."
	output OnClaimed(void) : "Se reclamo."
	output OnClaimFailed(void) : "Habia infectados dentro."
]

@PointClass base(Targetname) studio("models/props_junk/wood_crate001a.mdl") = survival_stash : "Alijo. +use saca un objeto. survival_stash_put guarda comida, agua o antidoto."
